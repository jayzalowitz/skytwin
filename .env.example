# ── Database ─────────────────────────────────────────────────────────
# 127.0.0.1 instead of 'localhost' so we never accidentally bind IPv6 ::
# on systems where /etc/hosts maps localhost to the unspecified address —
# CRDB is started in --insecure mode, broadcasting that to the LAN would
# be remote root. If you're connecting to a remote CRDB, set the URL to
# the actual host and switch sslmode to require.
DATABASE_URL=postgresql://root@127.0.0.1:26257/skytwin?sslmode=disable

# ── Services ─────────────────────────────────────────────────────────
API_PORT=3100
WEB_PORT=3200
WORKER_PORT=3101

# ── IronClaw (optional — leave blank to skip) ───────────────────────
# Known stable runtime as of 2026-06-25: IronClaw 0.29.1.
# IRONCLAW_API_URL=http://localhost:4000
# IRONCLAW_WEBHOOK_SECRET=your-webhook-secret

# ── OpenClaw / Ollama (optional — for local LLM reasoning) ──────────
# Known stable runtime as of 2026-06-25: OpenClaw 2026.6.10.
OPENCLAW_API_URL=http://localhost:3456
# OPENCLAW_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma4:latest
# BRIDGE_PORT=3456

# ── Environment ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Service auth (required whenever NODE_ENV is not `development`) ───
# The worker and the idle-miner POST connector signals to the API's
# /api/events/ingest, which sits behind session auth. In development the
# localhost bypass lets them through. Outside development you MUST share a
# loopback service credential between the API (verifier) and the worker +
# idle-miner (presenters), or every signal 401s and nothing is ingested.
#
#   SKYTWIN_SERVICE_TOKEN=$(openssl rand -hex 32)
#
# The packaged desktop app mints and persists this for you per install; only
# self-hosted / headless deployments need to set it by hand.
# SKYTWIN_SERVICE_TOKEN=

# Localhost auth bypass. Defaults to true only when NODE_ENV=development.
# Never enable this on anything reachable from outside the machine.
# SKYTWIN_DEV_AUTH_BYPASS=false

# ── Inference receipt identity (recommended for durable verification) ─
# Supply all three together. Values are base64-encoded PEM. If omitted, the
# API uses a process-local Ed25519 identity: receipts remain integrity-checkable
# but that recorder identity is not stable across restarts.
# SKYTWIN_RECEIPT_KEY_ID=host-2026-01
# SKYTWIN_RECEIPT_PRIVATE_KEY_BASE64=
# SKYTWIN_RECEIPT_PUBLIC_KEY_BASE64=

# ── Google OAuth (unsupported experimental source configuration) ────
# The supported technical preview is account-free sample only and keeps Google
# connections disabled. Credentials alone never enable Google. A future
# operator/BYO flow will require a Web Application OAuth client whose authorized
# redirect exactly matches GOOGLE_REDIRECT_URI. Do not commit client secrets or
# paste them into logs, issues, or support messages.
# SKYTWIN_GOOGLE_CONNECTION_MODE=disabled
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3100/api/oauth/google/callback

# ── Safety limits ────────────────────────────────────────────────────
# DEFAULT_SPEND_LIMIT_PER_ACTION=5000
# DEFAULT_DAILY_SPEND_LIMIT=50000
# APPROVAL_EXPIRY_SECONDS=3600
