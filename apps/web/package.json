{
  "name": "@skytwin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SkyTwin dashboard — Express-served SPA for monitoring decisions, approvals, and twin profiles.",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_OPTIONS='--max-old-space-size=384' tsx watch src/index.ts",
