{
  "name": "skytwin-desktop",
  "version": "0.3.0",
  "description": "SkyTwin Desktop — Your personal AI assistant",
  "author": {
    "name": "Jay Zalowitz",
    "email": "jay@skytwin.dev"
  },
  "homepage": "https://github.com/jayzalowitz/skytwin",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "tsc && electron .",
    "build": "node -e \"console.log('Desktop build requires: pnpm --filter skytwin-desktop package:[mac|win|linux]')\"",
    "test": "vitest run",
    "prepackage": "bash scripts/build-single-binary.sh",
    "package:mac": "tsc && pnpm run prepackage && electron-builder --mac",
    "package:win": "tsc && pnpm run prepackage && electron-builder --win",
    "package:linux": "tsc && pnpm run prepackage && electron-builder --linux",
    "package:all": "tsc && pnpm run prepackage && electron-builder --mac --win --linux",
    "package:signed": "tsc && pnpm run prepackage && npx ts-node scripts/sign-and-notarize.ts -- --mac --win --linux",
    "build:single-binary": "bash scripts/build-single-binary.sh"
  },
  "build": {
    "appId": "com.skytwin.desktop",
    "productName": "SkyTwin",
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "extraResources": [
        {
          "from": "dist/embedded/cockroach/darwin-arm64",
          "to": "cockroach/darwin-arm64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "dist/embedded/cockroach/darwin-x64",
          "to": "cockroach/darwin-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "dist/embedded/cockroach/win32-x64",
          "to": "cockroach/win32-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyTwin",
      "differentialPackage": false
    },
    "compression": "normal",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "assets/icons",
      "desktop": {
        "entry": {
          "Name": "SkyTwin",
          "Comment": "Your personal AI assistant",
          "Categories": "Utility;Office;"
        }
      },
      "extraResources": [
        {
          "from": "dist/embedded/cockroach/linux-x64",
          "to": "cockroach/linux-x64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "dist/embedded/cockroach/linux-arm64",
          "to": "cockroach/linux-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "jayzalowitz",
      "repo": "skytwin",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "src/splash.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/embedded",
        "to": "embedded",
        "filter": [
          "apps.tar.gz",
          "bundle-manifest.json"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
