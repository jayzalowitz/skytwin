{
  "name": "@skytwin/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --exclude '**/dist/**' && pnpm exec vitest run --root ../.. scripts/release-evidence/adversarial-v2-migration.test.mjs && node --test ../../scripts/release-evidence/verify-adversarial-evidence.test.mjs",
    "test:vitest": "vitest run --exclude '**/dist/**'",
    "lint": "tsc --noEmit",
    "eval": "pnpm eval:adversarial",
    "eval:adversarial": "tsx src/adversarial-cli.ts"
  },
  "dependencies": {
    "@skytwin/decision-engine": "workspace:*",
    "@skytwin/execution-router": "workspace:*",
    "@skytwin/explanations": "workspace:*",
    "@skytwin/ironclaw-adapter": "workspace:*",
    "@skytwin/policy-engine": "workspace:*",
    "@skytwin/shared-types": "workspace:*",
    "@skytwin/twin-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  }
}
