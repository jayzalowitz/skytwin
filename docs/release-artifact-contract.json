{
  "schemaVersion": 1,
  "releaseSurface": "desktop",
  "artifacts": [
    {
      "artifactName": "SkyTwin-macOS-dmg",
      "platform": "macos",
      "kind": "installer",
      "filenamePattern": "^SkyTwin-[A-Za-z0-9._+-]+\\.dmg$"
    },
    {
      "artifactName": "SkyTwin-macOS-zip",
      "platform": "macos",
      "kind": "archive",
      "filenamePattern": "^SkyTwin-[A-Za-z0-9._+-]+\\.zip$"
    },
    {
      "artifactName": "SkyTwin-macOS-update-manifest",
      "platform": "macos",
      "kind": "update-manifest",
      "filenamePattern": "^latest-mac\\.yml$"
    },
    {
      "artifactName": "SkyTwin-Windows-installer",
      "platform": "windows",
      "kind": "installer",
      "filenamePattern": "^SkyTwin[ ._-]Setup[ ._-][A-Za-z0-9._+-]+\\.exe$"
    },
    {
      "artifactName": "SkyTwin-Windows-update-manifest",
      "platform": "windows",
      "kind": "update-manifest",
      "filenamePattern": "^latest\\.yml$"
    },
    {
      "artifactName": "SkyTwin-Linux-AppImage",
      "platform": "linux",
      "kind": "installer",
      "filenamePattern": "^SkyTwin-[A-Za-z0-9._+-]+\\.AppImage$"
    },
    {
      "artifactName": "SkyTwin-Linux-deb",
      "platform": "linux",
      "kind": "package",
      "filenamePattern": "^skytwin-desktop_[A-Za-z0-9._+~-]+_(amd64|arm64)\\.deb$"
    },
    {
      "artifactName": "SkyTwin-Linux-rpm",
      "platform": "linux",
      "kind": "package",
      "filenamePattern": "^skytwin-desktop-[A-Za-z0-9._+~-]+\\.(x86_64|aarch64)\\.rpm$"
    },
    {
      "artifactName": "SkyTwin-Linux-update-manifest",
      "platform": "linux",
      "kind": "update-manifest",
      "filenamePattern": "^latest-linux\\.yml$"
    }
  ]
}
