#!/usr/bin/env bash
set -euo pipefail

# skytwin-dev — one-liner to start all SkyTwin services for development
#
# Usage:
#   ./bin/skytwin-dev               # start everything (native CRDB)
#   ./bin/skytwin-dev --use-docker  # use Docker for CRDB (legacy)
#   ./bin/skytwin-dev --no-ollama   # skip OpenClaw bridge / Ollama
#   ./bin/skytwin-dev --stop        # tear everything down
#
# Starts: CockroachDB, API, Web, Worker, optionally OpenClaw Bridge (Ollama)
# Ports:  3100 (API), 3200 (Web), 3101 (Worker), 3456 (OpenClaw), 26257 (CRDB)
#
# CockroachDB sourcing:
#   - Default (native): spawns the hash-verified cockroach binary
#     installed by `bin/skytwin-db install` under
#     $HOME/.local/share/skytwin/bin/cockroach. No Docker required.
#   - --use-docker / SKYTWIN_USE_DOCKER=true: starts the CRDB container
#     defined in docker-compose.yml. Kept for CI and users who already
#     have a Docker workflow.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [ -f "$ROOT/.env" ]; then
  while IFS='=' read -r key value; do
    case "$key" in
      COMPOSE_PROJECT_NAME|SKYTWIN_DB_PORT|SKYTWIN_DOCKER_SQL_PORT|SKYTWIN_DOCKER_ADMIN_PORT|SKYTWIN_DOCKER_API_PORT)
        value="${value%\"}"
        value="${value#\"}"
        export "$key=$value"
        ;;
    esac
  done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ROOT/.env")
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PIDFILE="$ROOT/.skytwin-pids"
SKIP_OLLAMA=false
USE_DOCKER="${SKYTWIN_USE_DOCKER:-false}"
CRDB_DOCKER_SQL_PORT="${SKYTWIN_DOCKER_SQL_PORT:-${SKYTWIN_DB_PORT:-26257}}"
CRDB_DOCKER_ADMIN_PORT="${SKYTWIN_DOCKER_ADMIN_PORT:-8080}"
export SKYTWIN_DOCKER_SQL_PORT="$CRDB_DOCKER_SQL_PORT"
export SKYTWIN_DOCKER_ADMIN_PORT="$CRDB_DOCKER_ADMIN_PORT"

compose_crdb_container() {
  docker compose ps -q cockroachdb 2>/dev/null
}

for arg in "$@"; do
  case "$arg" in
    --no-ollama) SKIP_OLLAMA=true ;;
    --use-docker) USE_DOCKER=true ;;
    --stop)
      echo -e "${YELLOW}Stopping SkyTwin services...${NC}"
      if [ -f "$PIDFILE" ]; then
        while read -r pid name; do
          if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null && echo -e "  ${RED}Stopped${NC} $name (PID $pid)"
          fi
        done < "$PIDFILE"
        rm -f "$PIDFILE"
      fi
      # Stop whichever CRDB we own. Native first (it's the default and
      # cheap to no-op when nothing's running); then Docker if it was
      # previously started.
      "$ROOT/bin/skytwin-db" stop 2>/dev/null | tail -1 || true
      docker compose stop cockroachdb 2>/dev/null && echo -e "  ${RED}Stopped${NC} CockroachDB (docker)" || true
      echo -e "${GREEN}All services stopped.${NC}"
      exit 0
      ;;
    --help|-h)
      echo "Usage: ./bin/skytwin-dev [--no-ollama] [--use-docker] [--stop]"
      echo ""
      echo "  --no-ollama   Skip OpenClaw bridge (no Ollama required)"
      echo "  --use-docker  Use Docker for CockroachDB instead of the native binary"
      echo "  --stop        Stop all running SkyTwin services"
      exit 0
      ;;
  esac
done

# Clean up any previous run
if [ -f "$PIDFILE" ]; then
  "$0" --stop 2>/dev/null || true
fi

echo -e "${BLUE}=== SkyTwin Development Server ===${NC}"
echo ""

# Default IronClaw to mock mode in dev unless the operator has wired up real
# credentials. Without this, the API logs "IronClaw not configured (no URL or
# secret) — skipping" and the execution router silently runs without it, which
# looks like a bug in the dashboard.
if [ -z "${IRONCLAW_API_URL:-}" ] && [ -z "${IRONCLAW_WEBHOOK_SECRET:-}" ]; then
  export USE_MOCK_IRONCLAW="${USE_MOCK_IRONCLAW:-true}"
fi

# 1. Check prerequisites
echo -e "${YELLOW}Checking prerequisites...${NC}"

# When bin/skytwin-install installed node via nvm, the resulting `node`
# only lives on PATH after `nvm.sh` is sourced. Interactive shells do that
# via .bashrc; a non-interactive subshell spawned by `nohup` (which is how
# install.sh starts this script) does NOT inherit nvm. Self-load it here
# so the script works regardless of how it's invoked.
if ! command -v node &>/dev/null; then
  if [ -s "${HOME}/.nvm/nvm.sh" ]; then
    # shellcheck disable=SC1091
    export NVM_DIR="${HOME}/.nvm"
    . "$NVM_DIR/nvm.sh"
  fi
fi

if ! command -v node &>/dev/null; then
  echo -e "  ${RED}Node.js not found.${NC} Run: ./bin/skytwin-install"
  exit 1
fi

NODE_MAJOR=$(node -v | sed 's/v//' | cut -d. -f1)
if [ "$NODE_MAJOR" -lt 20 ]; then
  echo -e "  ${RED}Node.js >= 20 required${NC} (found $(node -v)). Run: ./bin/skytwin-install"
  exit 1
fi
echo -e "  ${GREEN}Node.js${NC} $(node -v)"

if ! command -v pnpm &>/dev/null; then
  # corepack ships with modern Node — the install script enabled it but
  # only the parent shell saw the result. Re-enable so this subshell has
  # `pnpm` on PATH.
  if command -v corepack &>/dev/null; then
    corepack enable 2>/dev/null || true
    corepack prepare pnpm@9.1.0 --activate 2>/dev/null || true
  fi
fi
if ! command -v pnpm &>/dev/null; then
  echo -e "  ${RED}pnpm not found.${NC} Run: corepack enable && corepack prepare pnpm@9.1.0 --activate"
  exit 1
fi
echo -e "  ${GREEN}pnpm${NC} $(pnpm -v)"

if [ "$USE_DOCKER" = "true" ]; then
  if ! command -v docker &>/dev/null; then
    echo -e "  ${RED}Docker not found.${NC} Run: SKYTWIN_USE_DOCKER=true ./bin/skytwin-install"
    exit 1
  fi
  echo -e "  ${GREEN}Docker${NC} available"
fi

if [ "$SKIP_OLLAMA" = false ] && ! command -v ollama &>/dev/null; then
  echo -e "  ${YELLOW}Ollama not found${NC} — will skip OpenClaw bridge. Pass --no-ollama to suppress."
  SKIP_OLLAMA=true
fi

if [ "$SKIP_OLLAMA" = false ]; then
  echo -e "  ${GREEN}Ollama${NC} available"
fi

echo ""

# 2. Start CockroachDB
echo -e "${YELLOW}Starting CockroachDB...${NC}"
if [ "$USE_DOCKER" = "true" ]; then
  if curl -sf "http://localhost:${CRDB_DOCKER_SQL_PORT}/" &>/dev/null || curl -sf "http://localhost:${CRDB_DOCKER_ADMIN_PORT}/health" &>/dev/null; then
    echo -e "  ${GREEN}Already running${NC} on port ${CRDB_DOCKER_SQL_PORT}"
  else
    docker compose up -d cockroachdb 2>&1 | tail -2
    echo -n "  Waiting for health"
    for i in $(seq 1 30); do
      if curl -sf "http://localhost:${CRDB_DOCKER_ADMIN_PORT}/health" &>/dev/null; then
        echo -e " ${GREEN}ready${NC}"
        break
      fi
      echo -n "."
      sleep 1
    done
  fi

  # Create database if needed
  echo -e "${YELLOW}Ensuring database exists...${NC}"
  CRDB_CONTAINER="$(compose_crdb_container)"
  if [ -z "$CRDB_CONTAINER" ]; then
    echo -e "  ${RED}CockroachDB is listening on ${CRDB_DOCKER_SQL_PORT}/${CRDB_DOCKER_ADMIN_PORT}, but this Compose project does not own it.${NC}"
    echo "  Stop the other process or set SKYTWIN_DOCKER_SQL_PORT and SKYTWIN_DOCKER_ADMIN_PORT before retrying."
    exit 1
  fi
  docker exec "$CRDB_CONTAINER" cockroach sql --insecure -e "CREATE DATABASE IF NOT EXISTS skytwin;" 2>/dev/null \
    && echo -e "  ${GREEN}Database 'skytwin' ready${NC}" \
    || echo -e "  ${YELLOW}Could not verify database (may already exist)${NC}"
else
  # Native binary path. Idempotent — already-running is fine.
  "$ROOT/bin/skytwin-db" start 2>&1 | sed 's/^/  /'
  "$ROOT/bin/skytwin-db" ensure-db 2>&1 | sed 's/^/  /'
fi

# .env defaults used by build-time scripts, migrations, seed, and services.
if [ "$USE_DOCKER" = "true" ]; then
  export DATABASE_URL="${DATABASE_URL:-postgresql://root@127.0.0.1:${CRDB_DOCKER_SQL_PORT}/skytwin?sslmode=disable}"
else
  export DATABASE_URL="${DATABASE_URL:-postgresql://root@127.0.0.1:26257/skytwin?sslmode=disable}"
fi
export NODE_ENV="${NODE_ENV:-development}"
export API_PORT="${API_PORT:-3100}"
export OPENCLAW_API_URL="${OPENCLAW_API_URL:-http://localhost:3456}"

# 4. Install deps + build + migrate + seed (if needed)
if [ ! -d "node_modules" ]; then
  echo -e "${YELLOW}Installing dependencies...${NC}"
  pnpm install
fi

echo -e "${YELLOW}Building...${NC}"
# --concurrency=1 sidesteps the @skytwin/db turbo-race documented in
# CLAUDE.md. Fresh-install scenarios (skytwin-dev's first run after a
# clean checkout) hit it consistently; CI doesn't because its dist trees
# arrive pre-built. Cheap insurance for ~10s.
pnpm build --concurrency=1 2>&1 | tail -3

echo -e "${YELLOW}Running migrations...${NC}"
pnpm db:migrate 2>&1 | tail -3

# Seed only if no users exist. Native CRDB listens on 127.0.0.1 (not
# 'localhost') so we never accidentally bind IPv6 :: — match that here
# so the seed-skip check connects to the right endpoint.
USER_COUNT="0"
if [ "$USE_DOCKER" = "true" ]; then
  CRDB_CONTAINER="$(compose_crdb_container)"
  if [ -z "$CRDB_CONTAINER" ]; then
    echo -e "${RED}Docker CockroachDB container not found for this Compose project.${NC}"
    exit 1
  fi
  USER_COUNT=$(docker exec "$CRDB_CONTAINER" cockroach sql --insecure -e "SELECT count(*) FROM skytwin.users;" --format=csv 2>/dev/null | tail -1 || echo "0")
else
  COCKROACH_BIN="${SKYTWIN_DB_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/skytwin}/bin/cockroach"
  CRDB_HOST="${SKYTWIN_DB_LISTEN_HOST:-127.0.0.1}"
  if [ -x "$COCKROACH_BIN" ]; then
    USER_COUNT=$("$COCKROACH_BIN" sql --insecure --host "${CRDB_HOST}:${SKYTWIN_DB_PORT:-26257}" -d skytwin -e "SELECT count(*) FROM users;" --format=csv 2>/dev/null | tail -1 || echo "0")
  fi
fi
if [ "$USER_COUNT" = "0" ] || [ "$USER_COUNT" = "count" ]; then
  echo -e "${YELLOW}Seeding database...${NC}"
  pnpm db:seed 2>&1 | tail -5
fi

echo ""

# 5. Start services with process supervision
rm -f "$PIDFILE"

echo -e "${YELLOW}Starting services...${NC}"

MAX_RESTARTS=5
RESTART_DELAY=2

# supervised_run <name> <logfile> <command...>
# Runs a process in the background and restarts it on crash (up to MAX_RESTARTS).
supervised_run() {
  local name="$1"
  local logfile="$2"
  shift 2

  (
    child_pid=""
    trap '' HUP
    trap 'if [ -n "$child_pid" ]; then kill "$child_pid" 2>/dev/null; wait "$child_pid" 2>/dev/null; fi; exit' TERM INT

    restarts=0
    while [ "$restarts" -lt "$MAX_RESTARTS" ]; do
      "$@" >>"$logfile" 2>&1 &
      child_pid=$!
      wait "$child_pid"
      exit_code=$?
      child_pid=""
      if [ $exit_code -eq 0 ]; then
        break
      fi
      restarts=$((restarts + 1))
      echo "[$(date -Iseconds)] $name exited with code $exit_code, restart $restarts/$MAX_RESTARTS" >> "$logfile"
      sleep "$RESTART_DELAY"
    done
    if [ "$restarts" -ge "$MAX_RESTARTS" ]; then
      echo "[$(date -Iseconds)] $name exceeded max restarts ($MAX_RESTARTS), giving up" >> "$logfile"
    fi
  ) >/dev/null 2>&1 &
  local pid=$!
  echo "$pid $name" >> "$PIDFILE"
  echo "$pid"
}

# Service logs go under $ROOT/.logs/ so they survive reboots and stay
# next to the project. /tmp on systemd-managed distros may be ephemeral
# (PrivateTmp=yes) or tmpfiles.d-swept, which loses exactly the logs the
# user needs to diagnose a failed install. .logs/ is gitignored.
mkdir -p "$ROOT/.logs"

# API
API_PID=$(supervised_run api "$ROOT/.logs/skytwin-api.log" node apps/api/dist/index.js)
echo -e "  ${GREEN}API${NC}            http://localhost:${API_PORT}  (PID $API_PID)"

# Wait for API
for i in $(seq 1 15); do
  curl -sf "http://localhost:${API_PORT}/api/health" &>/dev/null && break
  sleep 1
done

# Web
WEB_PID=$(supervised_run web "$ROOT/.logs/skytwin-web.log" node apps/web/dist/index.js)
echo -e "  ${GREEN}Web Dashboard${NC}  http://localhost:3200  (PID $WEB_PID)"

# Worker
WORKER_PID=$(supervised_run worker "$ROOT/.logs/skytwin-worker.log" node apps/worker/dist/index.js)
echo -e "  ${GREEN}Worker${NC}         port 3101  (PID $WORKER_PID)"

# OpenClaw Bridge (if Ollama available)
if [ "$SKIP_OLLAMA" = false ]; then
  # Pull gemma4 if not available
  if ! ollama list 2>/dev/null | grep -q "gemma4"; then
    echo -e "  ${YELLOW}Pulling gemma4 model...${NC} (this may take a few minutes)"
    ollama pull gemma4:latest 2>&1 | tail -2
  fi

  BRIDGE_PID=$(BRIDGE_PORT=3456 supervised_run openclaw-bridge "$ROOT/.logs/skytwin-openclaw.log" node apps/openclaw-bridge/server.mjs)
  echo -e "  ${GREEN}OpenClaw Bridge${NC} http://localhost:3456  (PID $BRIDGE_PID)  [gemma4]"
fi

echo ""
echo -e "${GREEN}=== SkyTwin is running ===${NC}"
echo -e "  Open ${BLUE}http://localhost:3200${NC} in your browser"
echo -e "  Logs: $ROOT/.logs/skytwin-{api,web,worker,openclaw}.log"
echo -e "  Stop: ${YELLOW}./bin/skytwin-dev --stop${NC}"
echo -e "  Processes auto-restart on crash (max ${MAX_RESTARTS} times)"
echo ""
