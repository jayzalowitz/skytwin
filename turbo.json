{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "SKYTWIN_DEV_AUTH_BYPASS",
        "USE_MOCK_IRONCLAW",
        "IRONCLAW_API_URL",
        "IRONCLAW_WEBHOOK_SECRET",
        "DATABASE_URL",
        "OPENCLAW_API_URL",
        "BRIDGE_PORT",
        "OLLAMA_HOST",
        "OLLAMA_MODEL",
        "AWARENESS_DISPOSITION_GATE"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
