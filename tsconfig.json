{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@skytwin/capability-engine": ["./packages/capability-engine/src"],
      "@skytwin/config": ["./packages/config/src"],
      "@skytwin/connectors": ["./packages/connectors/src"],
      "@skytwin/core": ["./packages/core/src"],
      "@skytwin/credential-vault": ["./packages/credential-vault/src"],
      "@skytwin/db": ["./packages/db/src"],
      "@skytwin/decision-engine": ["./packages/decision-engine/src"],
      "@skytwin/dxt": ["./packages/dxt/src"],
      "@skytwin/embedded-llm": ["./packages/embedded-llm/src"],
      "@skytwin/evals": ["./packages/evals/src"],
      "@skytwin/execution-router": ["./packages/execution-router/src"],
      "@skytwin/explanations": ["./packages/explanations/src"],
      "@skytwin/idle-miner": ["./packages/idle-miner/src"],
      "@skytwin/ironclaw-adapter": ["./packages/ironclaw-adapter/src"],
      "@skytwin/mempalace": ["./packages/mempalace/src"],
      "@skytwin/memory-gbrain": ["./packages/memory-gbrain/src"],
      "@skytwin/memory-gbrain-crdb-adapter": ["./packages/memory-gbrain-crdb-adapter/src"],
      "@skytwin/memory-hybrid": ["./packages/memory-hybrid/src"],
      "@skytwin/memory-mempalace": ["./packages/memory-mempalace/src"],
      "@skytwin/memory-port": ["./packages/memory-port/src"],
      "@skytwin/observability": ["./packages/observability/src"],
      "@skytwin/policy-engine": ["./packages/policy-engine/src"],
      "@skytwin/registry-client": ["./packages/registry-client/src"],
      "@skytwin/routines": ["./packages/routines/src"],
      "@skytwin/shared-types": ["./packages/shared-types/src"],
      "@skytwin/twin-model": ["./packages/twin-model/src"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage"]
}
